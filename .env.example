# 스마트 대국 — 환경변수 설정
# 이 파일을 복사해서 .env 로 저장하고 값을 채우세요
# cp .env.example .env

# ── 서버 ──────────────────────────────────────────────────
PORT=3101
NODE_ENV=production

# ── 보안 (반드시 변경) ────────────────────────────────────
# 32자 이상 랜덤 문자열 권장
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ── CORS ──────────────────────────────────────────────────
# 허용할 도메인. 여러 개면 쉼표 구분 (또는 * 로 전체 허용)
# CORS_ORIGIN=https://yourdomain.com
CORS_ORIGIN=*

# ── 데이터 경로 ───────────────────────────────────────────
# SQLite DB (baduk.db) 와 sgf_records/ 가 저장될 디렉토리
# Docker 사용 시 볼륨 마운트 경로와 맞춰야 함
DATA_DIR=/app/data